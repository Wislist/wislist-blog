{# NexT sidebar hook 位于站点概览内，保留文章目录/站点概览切换。 #}
<div class="visitor-sidebar" id="visitor-sidebar">
  <section class="visitor-card" aria-labelledby="visitor-weather-title">
    <h2 id="visitor-weather-title">你好，欢迎来访</h2>
    <div id="visitor-weather-status" role="status" aria-live="polite" aria-busy="true">
      <p id="visitor-location" class="weather-location">正在定位…</p>
      <div class="weather-display">
        <a class="weather-art" href="https://open-meteo.com/" target="_blank" rel="noopener noreferrer" aria-label="天气数据来源 Open-Meteo" title="Open-Meteo">
          <svg id="visitor-weather-icon" viewBox="0 0 80 80" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><circle cx="40" cy="40" r="15"/></svg>
        </a>
        <div><div id="visitor-temperature" class="weather-temperature">—°</div><p id="visitor-weather">正在获取天气</p></div>
      </div>
      <p id="visitor-weather-detail" class="weather-detail"></p>
    </div>
  </section>
  <section class="visitor-card" aria-labelledby="visitor-stats-title">
    <h2 id="visitor-stats-title">网站信息</h2>
    <p id="visitor-stats-status" role="status" aria-live="polite" aria-busy="true">正在加载访问统计…</p>
    <dl id="visitor-stats-values" hidden>
      <div class="visitor-stat"><dt>总浏览量</dt><dd id="visitor-total-views"></dd></div>
      <div class="visitor-stat"><dt>独立访客</dt><dd id="visitor-total-visitors"></dd></div>
      <div class="visitor-stat"><dt>今日浏览</dt><dd id="visitor-today-views"></dd></div>
      <div class="visitor-stat"><dt>统计启用</dt><dd id="visitor-stats-since"></dd></div>
    </dl>
  </section>
  <noscript><p class="visitor-note">启用 JavaScript 后可查看天气与访问统计。</p></noscript>
</div>
<script src="/js/visitor-sidebar.js" defer></script>
