// ===============================================================
// 自定义样式
// ===============================================================

// 保留源码真实换行；长行在代码块内横向滚动，不撑开移动端正文。
figure.highlight
  max-width 100%
  overflow-x auto

  pre
    white-space pre
    word-break normal
    overflow-wrap normal

.post-body
  min-width 0

// 暗色下避免复制按钮的浅灰渐变遮住源码。
@media (prefers-color-scheme: dark)
  .copy-btn
    background none
    background-color rgba(255, 255, 255, .12)
    border 1px solid rgba(255, 255, 255, .18)
    border-radius 3px
    color var(--highlight-foreground)

  .copy-btn:hover
    background-color rgba(255, 255, 255, .22)

// 使用 NexT 色彩变量，随主题深浅色切换；不添加装饰性动画。
.visitor-sidebar
  margin-top 22px
  text-align left
  color var(--text-color)

.visitor-card
  padding 16px
  margin-top 12px
  border 1px solid var(--body-bg-color)
  border-radius 8px
  background var(--card-bg-color)
  font-size 13px
  line-height 1.7
  overflow-wrap anywhere

  h2
    margin 0 0 8px
    font-size 14px
    font-weight 600
    line-height 1.5

  p
    margin 5px 0

  .visitor-note
    color var(--text-color)
    opacity .72
    font-size 11px

  dl
    margin 12px 0 0

  .visitor-stat
    display flex
    justify-content space-between
    gap 12px
    margin 6px 0

  dt, dd
    margin 0

  dd
    font-variant-numeric tabular-nums
    text-align right

  [hidden]
    display none

.weather-location
  opacity .7
  font-size 12px

.weather-display
  display flex
  align-items center
  gap 14px
  padding 12px 0 8px

.weather-art
  flex 0 0 72px
  width 72px
  height 72px
  border 0 !important
  color var(--text-color)

  svg
    width 100%
    height 100%

  [data-weather='sun']
    color #d6a44b

  [data-weather='rain'], [data-weather='snow'], [data-weather='storm']
    color #79a9c9

.weather-temperature
  font-size 38px
  line-height 1.1
  font-weight 500
  letter-spacing -2px
  font-variant-numeric tabular-nums

.visitor-card .weather-detail
  margin-top 8px
  opacity .7
  font-size 12px


// Twikoo 的历史表情经过服务端清洗后可能没有 class，用表情 alt 标记一并匹配。
#twikoo
  .tk-content
    font-size 15px
    line-height 1.75
    overflow-wrap anywhere
    word-break normal

    p
      margin 0 0 .6em

    img
      max-width 100%
      height auto

    img.tk-owo-emotion, img.vemoji, img[alt^=':'][alt$=':']
      display inline-block
      width 1.5em
      height 1.5em
      max-width 1.5em
      max-height 1.5em
      margin 0 .08em
      vertical-align -.3em
      object-fit contain

  .tk-preview img.tk-owo-emotion, .tk-preview img[alt^=':'][alt$=':']
    display inline-block
    width 1.5em
    height 1.5em
    margin 0 .08em
    vertical-align -.3em

  .tk-comment
    margin-top 20px

    &:target
      outline 2px solid var(--link-color)
      outline-offset 6px
      border-radius 4px

  .tk-row
    gap 8px

  .tk-meta
    display flex
    align-items baseline
    flex-wrap wrap
    gap 4px 8px

  .tk-time
    margin-left 0

  .tk-action-link
    border-bottom 0

  .tk-extras
    font-size 11px
    opacity .7

  .tk-replies
    margin-top 14px
    padding-left 18px
    border-left 2px solid rgba(144, 147, 153, .35)

    > .tk-comment
      margin-top 16px

      &:first-child
        margin-top 0

    .tk-content > span:first-child:has(.tk-ruser)
      display block
      margin-bottom 6px
      font-size 12px
      color var(--link-color)

    .tk-ruser
      font-weight 600
      border-bottom 0

  .tk-footer
    display none

.site-tools
  margin 10px auto 0
  max-width 620px
  font-size 12px
  line-height 1.9

  summary
    cursor pointer
    width fit-content
    margin auto

  p
    margin 8px 0 0

.footer-hitokoto
  margin 0 auto 18px
  max-width 620px
  padding 0 12px
  min-height 3.8em
  font-size 14px
  line-height 1.9
  color var(--text-color)

  &[hidden]
    display none

  .hitokoto-text
    display grid
    border-bottom 0
    font inherit
    color inherit

  .hitokoto-measure, .hitokoto-typed
    grid-area 1 / 1
    min-width 0
    overflow-wrap anywhere

  .hitokoto-measure
    visibility hidden

  .hitokoto-typed::after
    content ''
    display inline-block
    width 1px
    height 1em
    margin-left 3px
    background currentColor
    vertical-align -.12em

@media (prefers-reduced-motion: reduce)
  .footer-hitokoto .hitokoto-typed::after
    display none

@media (max-width: 767px)
  #twikoo .tk-replies
    padding-left 10px

  #twikoo .tk-comment > .tk-avatar
    margin-right 10px
